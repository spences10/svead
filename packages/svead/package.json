{
	"name": "svead",
	"version": "0.1.0",
	"keywords": [
		"facebook",
		"head",
		"json-ld",
		"jsonld",
		"meta-tags",
		"og",
		"open-graph",
		"schema",
		"seo",
		"social",
		"structured-data",
		"svelte",
		"sveltekit",
		"twitter"
	],
	"homepage": "https://github.com/spences10/svead#readme",
	"bugs": {
		"url": "https://github.com/spences10/svead/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Scott Spence",
		"email": "svead@scottspence.dev",
		"url": "https://scottspence.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/spences10/svead.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "pnpm run package",
		"package": "pnpm run package:readme && svelte-package && publint",
		"package:readme": "cp ../../README.md README.md",
		"prepublishOnly": "pnpm run package",
		"test": "pnpm run test:ci",
		"check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"lint": "pnpm -w lint",
		"format": "pnpm -w format",
		"test:unit": "vp test",
		"test:ci": "vp test --run",
		"coverage": "vp test --run --coverage"
	},
	"dependencies": {
		"schema-dts": "^2.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@typescript/native": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"playwright": "catalog:",
		"publint": "^0.3.21",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tslib": "^2.8.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "catalog:"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"engines": {
		"node": ">=24.15.0"
	}
}
